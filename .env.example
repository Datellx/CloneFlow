# Copy to .env.local and fill in. Never commit real keys.
MODEL_API_KEY=              # Meta Model API key. Without it, an offline stand-in model is used (no cost).
CLOUD_MODEL=muse-spark-1.3
PUBLIC_URL=http://localhost:8000
ORG_AI_CAP_USD=2
# Supabase: sign-in (verified emails, password resets, invitation emails) and the Postgres database.
# Without these, a local SQLite file and built-in email + password sign-in are used (development).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=  # server only, never in the browser; sends invitation emails
DATABASE_URL=               # Supabase → Connect → Session pooler connection string            # AI allowance per organization on the free trial (0 = no limit)
TTS_PROVIDER=browser        # browser | openai | elevenlabs (with TTS_API_KEY)

# Connectors (optional): register OAuth apps and add their keys
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=organizations
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
